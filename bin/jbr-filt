# jbr-filt — user-facing command; runs libexec/jbr-filt.py with all arguments.
#
# Thin wrapper: the implementation language is a detail (PRD.md D-77).
# Exempt from the AGENTS.md usage/--help/trap rules: --help is passed on to
# the Python script, and exec replaces the shell. Must be invoked via its
# real path, not through a symlink.

set -eu -o pipefail

exec python3 "$(dirname "$0")/../libexec/$(basename "$0").py" "$@"
